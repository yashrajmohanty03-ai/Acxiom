
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="container-fluid py-4">
    <h1 class="mb-2">AcxiomCRM Dashboard</h1>
    <p class="text-muted">Customer Relationship Management Overview</p>

    <div class="row g-3 mt-3">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm p-3">
                <h6>Total Customers</h6>
                <h2>0</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm p-3">
                <h6>Total Leads</h6>
                <h2>0</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm p-3">
                <h6>Open Opportunities</h6>
                <h2>0</h2>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm p-3">
                <h6>Pipeline Value</h6>
                <h2>₹0</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4 p-4">
        <h4>Welcome to AcxiomCRM</h4>
        <p>
            Manage customers, leads, follow-ups and sales opportunities
            from one place.
        </p>
        <p class="mb-0">
            This dashboard is the initial layout. We will connect it
            to actual database records next.
        </p>
    </div>
</div>
